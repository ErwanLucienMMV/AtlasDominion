{
  "name": "atlas-dominion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:backup": "node apps/backup-worker/main.mjs",
    "start:discord": "node apps/discord-api/main.mjs",
    "start:controller": "node apps/docker-controller/main.mjs",
    "test": "node --test",
    "validate:registry": "node scripts/validate-registry.mjs",
    "render:infrastructure": "node scripts/render-infrastructure.mjs",
    "check:infrastructure": "node --test infrastructure/checks/compose.check.mjs",
    "check:production": "node --test infrastructure/checks/compose.check.mjs infrastructure/checks/monitoring.check.mjs infrastructure/checks/backup.check.mjs"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "dockerode": "5.0.1",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
