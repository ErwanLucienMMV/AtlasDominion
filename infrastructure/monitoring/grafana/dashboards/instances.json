{
  "uid": "atlas-instances", "title": "Atlas lifecycle and host capacity", "schemaVersion": 39,
  "version": 1, "editable": false, "timezone": "browser", "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "server", "label": "Server instance", "type": "query", "datasource": {"type": "prometheus", "uid": "atlas-prometheus"}, "query": "label_values(atlas_instance_info, instance)", "refresh": 1, "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}}]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Observed instance states", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"uid": "atlas-prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "atlas_instance_state{instance=~\"$server\"} == 1", "legendFormat": "{{instance}} {{state}}"}]},
    {"id": 2, "type": "timeseries", "title": "Admission reservations / budget (not measured host usage)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"uid": "atlas-prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "atlas_reserved / atlas_capacity", "legendFormat": "{{resource}}"}]},
    {"id": 3, "type": "timeseries", "title": "Measured host CPU and memory utilization", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"uid": "atlas-prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "legendFormat": "CPU"}, {"refId": "B", "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "legendFormat": "memory"}]},
    {"id": 4, "type": "timeseries", "title": "Measured game container memory bytes", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"uid": "atlas-prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "atlas_container_memory_bytes{instance=~\"$server\"}", "legendFormat": "{{instance}}"}]},
    {"id": 5, "type": "timeseries", "title": "Measured game CPU cores consumed", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"uid": "atlas-prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "rate(atlas_container_cpu_seconds_total{instance=~\"$server\"}[5m])", "legendFormat": "{{instance}}"}]},
    {"id": 6, "type": "timeseries", "title": "Lifecycle outcomes per second", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"uid": "atlas-prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "rate(atlas_operations_total{instance=~\"$server\"}[5m])", "legendFormat": "{{instance}} {{action}} {{outcome}}"}]},
    {"id": 7, "type": "timeseries", "title": "Controller health and event stream", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "datasource": {"uid": "atlas-prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "atlas_controller_ready", "legendFormat": "ready"}, {"refId": "B", "expr": "atlas_docker_events_connected", "legendFormat": "events connected"}, {"refId": "C", "expr": "atlas_controller_active_operations", "legendFormat": "active operations"}, {"refId": "D", "expr": "atlas_controller_audit_pending", "legendFormat": "unpersisted audit"}]},
    {"id": 8, "type": "timeseries", "title": "Unexpected exits", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "datasource": {"uid": "atlas-prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "increase(atlas_instance_unexpected_exits_total{instance=~\"$server\"}[5m])", "legendFormat": "{{instance}}"}]},
    {"id": 9, "type": "timeseries", "title": "Resource sampling readiness", "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8}, "datasource": {"uid": "atlas-prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "atlas_resource_sampling_ready", "legendFormat": "sampling ready"}]},
    {"id": 10, "type": "timeseries", "title": "Seconds since completed resource sampling pass", "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8}, "datasource": {"uid": "atlas-prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "time() - atlas_resource_sampling_timestamp_seconds", "legendFormat": "sampling age"}]}
  ]
}
